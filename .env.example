# Copy to .env and fill in. Run scripts/init-env.py first to generate the
# secret values (JWT/session/Meilisearch/crypto keys, DB passwords) uniquely
# for this deployment. Then edit provider keys and domain settings by hand.
# chmod 600 .env after editing. Never commit this file.

### Domain / TLS ###
CHAT_DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com

### App identity ###
APP_TITLE=Multi-AI Chat
HOST=0.0.0.0
PORT=3080

### Generated secrets (produced by scripts/init-env.py — do not hand-edit) ###
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
SESSION_SECRET=
MEILI_MASTER_KEY=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

### Registration / auth ###
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

### Optional OAuth (leave blank to disable) ###
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

### Provider API keys — leave blank to disable a provider ###
OPENAI_API_KEY=
OPENAI_MODELS=gpt-6.1-sol,gpt-6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5

GOOGLE_KEY=
GOOGLE_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/YOUR_WORKSPACE_ID
QWEN_TURBO_MODEL=qwen-turbo
QWEN_PLUS_MODEL=qwen-plus

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

### RAG / embeddings ###
RAG_IMAGE=ghcr.io/danny-avila/librechat-rag-api-dev:latest
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
RAG_OPENAI_API_KEY=

### Compose profiles (comma-separated) ###
# "standalone" — run the bundled Caddy, owning host ports 80/443. Use this
#   when nothing else on the host is already listening on those ports.
# "router"     — run LiteLLM for the coding/research/cheap/auto aliases.
# Omit "standalone" when deploying behind an existing reverse proxy already
# running on the host: librechat is always reachable at 127.0.0.1:3080
# regardless of this setting — point that proxy's site-block there instead.
# Example for a shared-host deployment with the router enabled: router
COMPOSE_PROFILES=standalone

### Backups ###
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_REMOTE_ENV=
