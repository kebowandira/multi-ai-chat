{
  "_comment": "Order matters within each list and within classification_rules. Edited by hand; scripts/configure.py reads this to build LiteLLM's router_settings.fallbacks and prunes any model name whose provider key is absent.",

  "limits": {
    "max_input_chars": 48000,
    "max_output_tokens": 4096
  },

  "routes": {
    "coding": ["nvidia-laguna", "nvidia-nemotron-ultra", "gemini-3.6-flash", "gemini-3.5-flash-lite", "groq-120b", "openrouter-nemotron", "claude-code", "deepseek-fast", "openai-main"],
    "research": ["nvidia-nemotron-ultra", "gemini-3.6-flash", "gemini-3.5-flash-lite", "groq-120b", "openrouter-nemotron", "gemini-flash", "openai-main"],
    "cheap": ["gemini-3.5-flash-lite", "groq-qwen", "openrouter-nemotron", "qwen-turbo", "deepseek-fast", "openai-low-cost", "gemini-flash-lite"]
  },

  "default_route": "cheap",

  "classification_rules": [
    {
      "route": "coding",
      "pattern": "(?i)\\b(debug|refactor|function|class|stack trace|traceback|compile|regex|unit test|pull request|mql[45]|python|javascript|typescript|c\\+\\+|sql query|bug|exception|null pointer|segfault)\\b"
    },
    {
      "route": "research",
      "pattern": "(?i)\\b(compare|analysis|riset|penelitian|market research|literature review|summarize the arguments|pros and cons|cite|citation|pasar indonesia)\\b"
    },
    {
      "route": "cheap",
      "pattern": "(?i)\\b(rewrite|summarize|shorten|rephrase|proofread|translate|tidy up)\\b"
    }
  ]
}
